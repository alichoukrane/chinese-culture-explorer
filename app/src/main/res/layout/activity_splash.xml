<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen splash image. Replace splash_photo.png in /res/drawable with your banner image.
         Use the attached banner file and keep the file name exactly splash_photo.png so the app loads it without errors. -->
    <ImageView
        android:id="@+id/splash_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_photo"
        android:contentDescription="@string/app_name" />

</FrameLayout>
